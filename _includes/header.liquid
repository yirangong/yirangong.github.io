<header class="site-header portfolio-header">
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Primary navigation"
  >
    <div class="container portfolio-nav">
      <a
        class="portfolio-brand"
        href="{{ '/' | relative_url }}"
        aria-label="Yiran Gong, home"
        {% if page.url == '/' %}
          aria-current="page"
        {% endif %}
      >
        <span class="portfolio-brand__name">Yiran Gong</span>
      </a>

      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse portfolio-nav__links" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item {% if page.url contains '/about/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/about/' | relative_url }}"
              {% if page.url contains '/about/' %}
                aria-current="page"
              {% endif %}
            >
              about me
            </a>
          </li>
          <li class="nav-item {% if page.url contains '/build/' or page.pillar == 'build' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/build/' | relative_url }}"
              {% if page.url contains '/build/' or page.pillar == 'build' %}
                aria-current="page"
              {% endif %}
            >
              building...
            </a>
          </li>
          <li class="nav-item {% if page.url contains '/understand/' or page.pillar == 'understand' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/understand/' | relative_url }}"
              {% if page.url contains '/understand/' or page.pillar == 'understand' %}
                aria-current="page"
              {% endif %}
            >
              understanding...
            </a>
          </li>

          {% comment %}
            Reserved CTA slot. Restore this list item when the destination and
            label are ready.
            <li class="nav-item portfolio-nav__cta">
              <a class="nav-link" href="mailto:{{ site.data.socials.email }}">Get in touch</a>
            </li>
          {% endcomment %}
        </ul>
      </div>

    </div>
  </nav>
</header>
