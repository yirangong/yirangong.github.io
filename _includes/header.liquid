<header class="site-header">
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Primary navigation"
  >
    <div class="container portfolio-nav">
      <a class="portfolio-brand" href="{{ '/' | relative_url }}" aria-label="Yiran Gong, home">
        <span class="portfolio-brand__mark">YG</span>
        <span class="portfolio-brand__name">Yiran Gong</span>
      </a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              {% assign nav_active = false %}
              {% if page.url contains parent_link %}{% assign nav_active = true %}{% endif %}
              {% if page.pillar and p.pillar == page.pillar %}{% assign nav_active = true %}{% endif %}
              <li class="nav-item {% if nav_active %}active{% endif %}">
                <a class="nav-link" href="{{ p.url | relative_url }}">
                  <span class="nav-index">{{ p.nav_index }}</span>
                  <span>{{ p.nav_label | default: p.title }}</span>
                  {% if nav_active %}<span class="sr-only">(current)</span>{% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>
</header>
