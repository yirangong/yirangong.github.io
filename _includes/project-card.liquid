{% assign project = include.project %}
<article class="project-card project-card--{{ project.pillar }}">
  <a class="project-card__link" href="{{ project.url | relative_url }}" aria-label="Read {{ project.title }}">
    <div class="project-card__index" aria-hidden="true">
      <span>{{ project.index }}</span>
      <span>{{ project.pillar | upcase }}</span>
    </div>

    <div class="project-card__body">
      <div class="project-card__eyebrow">
        <span>{{ project.kind }}</span>
        {% if project.status == 'draft' %}<span class="draft-flag">Framework preview</span>{% endif %}
      </div>
      <h3>{{ project.title }}</h3>
      <p>{{ project.summary }}</p>

      <dl class="project-card__facts">
        {% if project.role %}
          <div><dt>Role</dt><dd>{{ project.role }}</dd></div>
        {% endif %}
        {% if project.skills %}
          <div><dt>Methods</dt><dd>{{ project.skills | join: ' · ' }}</dd></div>
        {% endif %}
      </dl>
    </div>

    <span class="project-card__arrow" aria-hidden="true">↗</span>
  </a>
</article>
