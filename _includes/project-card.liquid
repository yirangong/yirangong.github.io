{% assign project = include.project %}
{% assign card_title = project.card_title | default: project.title %}
<article class="project-card project-card--{{ project.pillar }}">
  <a class="project-card__link" href="{{ project.url | relative_url }}" aria-label="Read {{ project.title }}">
    <div class="project-card__preview" aria-hidden="true"></div>

    <div class="project-card__body">
      <div class="project-card__top">
        <span class="project-card__kind">{{ project.kind }}</span>
        {% if project.card_badge %}
          <span class="project-card__flag">{{ project.card_badge }}</span>
        {% elsif project.status == 'draft' %}
          <span class="project-card__flag">Draft</span>
        {% endif %}
      </div>

      <h3>{{ card_title }}</h3>
      {% if project.card_detail %}
        <p class="project-card__metric">{{ project.card_detail }}</p>
      {% elsif project.metrics and project.metrics.first %}
        <p class="project-card__metric">
          <strong>{{ project.metrics.first.value }}</strong> {{ project.metrics.first.label }}
        </p>
      {% else %}
        <p class="project-card__metric">{{ project.summary }}</p>
      {% endif %}
    </div>
  </a>
</article>
