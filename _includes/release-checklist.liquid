<!--
  Release checklist — 04 / Deploy.
  The eight steps grouped by what each one is about, so the list reads as
  four decisions rather than eight chores. Label lane left, number lane
  centre, step right. Styles: ".rs-steps" in _sass/_portfolio.scss.
-->
<ol class="rs-steps">
  <li class="rs-steps__group">
    <p class="rs-steps__label">Assets</p>
    <ol class="rs-steps__items">
      <li>Host the reference assets.</li>
      <li>Prepare the demo video and a correctly cropped cover.</li>
    </ol>
  </li>

  <li class="rs-steps__group">
    <p class="rs-steps__label">Pricing</p>
    <ol class="rs-steps__items" start="3">
      <li>Convert API cost into the product&rsquo;s pricing unit.</li>
    </ol>
  </li>

  <li class="rs-steps__group">
    <p class="rs-steps__label">Engine</p>
    <ol class="rs-steps__items" start="4">
      <li>Configure the engine, provider, target, and preprocessing policy.</li>
      <li>Bind the user image to the workflow input.</li>
      <li>Connect the engine to the template.</li>
    </ol>
  </li>

  <li class="rs-steps__group">
    <p class="rs-steps__label">Release</p>
    <ol class="rs-steps__items" start="7">
      <li>Test the complete experience in beta.</li>
      <li>Configure the production version.</li>
    </ol>
  </li>
</ol>
