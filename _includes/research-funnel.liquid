<!-- Research funnel — 01 / Research.
     Flat shapes + live text only (no filters/gradients); colors come from the
     Pavilion tokens in _sass/_tokens.scss. Styles live in _sass/_portfolio.scss
     under ".rs-funnel". Edit the four chip labels below to change the sources. -->
<figure class="rs-funnel">
  <svg viewBox="0 0 552 290" role="img" aria-labelledby="rsFunnelTitle rsFunnelDesc">
    <title id="rsFunnelTitle">Research funnel: four inspiration sources narrow through human judgment</title>
    <desc id="rsFunnelDesc">Reddit finds, scenes from movies, insider jokes and hallucinated prompts converge on a judgment gate, with an arrow leading onward to the next step.</desc>

    <text class="rs-funnel__note" x="8" y="26">MANY CANDIDATES</text>

    <!-- converging paths (drawn first, sit behind the chips) -->
    <g class="rs-funnel__paths">
      <path d="M176,80  C 286,80  300,170 406,170" />
      <path d="M176,140 C 286,140 300,170 406,170" />
      <path d="M176,200 C 286,200 300,170 406,170" />
      <path d="M176,260 C 286,260 300,170 406,170" />
    </g>

    <!-- source chips -->
    <g class="rs-funnel__chips">
      <rect x="8" y="61" width="168" height="38" rx="8" />
      <rect x="8" y="121" width="168" height="38" rx="8" />
      <rect x="8" y="181" width="168" height="38" rx="8" />
      <rect x="8" y="241" width="168" height="38" rx="8" />
    </g>

    <g class="rs-funnel__label">
      <text x="24" y="85">Reddit finds</text>
      <text x="24" y="145">Scenes from movies</text>
      <text x="24" y="205">Insider jokes</text>
      <text x="24" y="265">Hallucinated prompts</text>
    </g>

    <!-- the gate — the actual point of the diagram -->
    <rect class="rs-funnel__gate" x="406" y="122" width="46" height="96" rx="23" />

    <g class="rs-funnel__note" text-anchor="middle">
      <text x="429" y="240">HUMAN</text>
      <text x="429" y="254">JUDGMENT</text>
    </g>

    <!-- onward -->
    <g class="rs-funnel__arrow">
      <path d="M452,170 H540" />
      <path d="M534,164 l6,6 -6,6" />
    </g>
  </svg>
</figure>
