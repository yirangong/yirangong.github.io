---
layout: default
---
{% assign featured_projects = site.projects | where: 'featured', true | sort: 'importance' %}
{% assign featured_project = featured_projects | first %}
{% assign featured_image = featured_project.card_image | default: '/assets/projects/applied-ai-product-operations/hero-workflow.png' %}

<main class="portfolio-home home-pavilion">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <h1 id="home-title" class="home-hero__title">
        <span class="home-hero__line">Hi, I&rsquo;m Yiran.</span>
        <span class="home-hero__line">
          a <span class="home-hero__product">product</span>
          <span class="home-hero__amp">&amp;</span>
          <span class="home-hero__ai">AI</span> builder,
        </span>
        <span class="home-hero__line">with a background in</span>
        <span class="home-hero__line"> <span class="home-hero__cognition">cognitive science,</span> building </span>
        <span class="home-hero__line">thoughtful technology for</span>
        <span class="home-hero__line">deeply <span class="home-hero__human">human contexts.</span></span>
      </h1>

      <div class="home-hero__bottom">
        <p class="home-hero__lede">
          My work moves between implementation and inquiry.<br>
          Both begin with close observation &mdash; of behavior, communities, and the systems around us.
        </p>
        <div class="route-actions">
          <a class="route-button route-button--dark" href="{{ '/build/' | relative_url }}">See what I build <span>↗</span></a>
          <a class="route-button" href="{{ '/understand/' | relative_url }}">See what I study <span>↗</span></a>
        </div>
      </div>
    </div>

    <figure class="home-hero__portrait">
      <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Yiran Gong beside a bronze statue at night">
    </figure>
  </section>

  {% if featured_project %}
    <section class="home-featured" aria-labelledby="featured-project-title">
      <a
        class="home-featured__card"
        href="{{ featured_project.url | relative_url }}"
        aria-label="View {{ featured_project.card_title | default: featured_project.title }}"
      >
        <figure class="home-featured__media">
          <img
            src="{{ featured_image | relative_url }}"
            alt="Generative video workflow showing the final render, model pipeline, and anatomy-aware evaluation"
          >
        </figure>

        <div class="home-featured__content">
          <p class="home-featured__eyebrow">{{ featured_project.kind }}</p>
          <h2 id="featured-project-title">{{ featured_project.card_title | default: featured_project.title }}</h2>
          <p class="home-featured__summary">{{ featured_project.summary }}</p>

          {% if featured_project.metrics %}
            <dl class="home-featured__metrics">
              {% for metric in featured_project.metrics limit: 3 %}
                <div>
                  <dt>{{ metric.value }}</dt>
                  <dd>{{ metric.label }}</dd>
                </div>
              {% endfor %}
            </dl>
          {% endif %}

          {% if featured_project.skills %}
            <ul class="home-featured__skills" aria-label="Project skills">
              {% for skill in featured_project.skills limit: 5 %}
                <li>{{ skill }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          <span class="home-featured__cta">View project <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </section>
  {% endif %}

  <section class="home-contact" aria-labelledby="home-contact-title">
    <div class="home-contact__main">
      <span class="home-contact__eyebrow">CONTACT</span>
      <h2 id="home-contact-title">I work where technical systems meet human behavior.</h2>
      <div class="route-actions">
        {% if site.data.socials.email %}
          <a class="route-button route-button--light" href="mailto:{{ site.data.socials.email }}">Get in touch <span>↗</span></a>
        {% endif %}
        <a class="route-button route-button--ghost" href="{{ '/assets/pdf/resume.pdf' | relative_url }}" download>Download CV <span>↓</span></a>
      </div>
    </div>

    <div class="home-contact__meta">
      <div>
        <span class="home-contact__label">AVAILABLE FOR</span>
        <p>2027 full-time Product &amp; AI roles</p>
      </div>
      <div>
        <span class="home-contact__label">ELSEWHERE</span>
        <p>
          <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub ↗</a>
          ·
          <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn ↗</a>
        </p>
      </div>
    </div>
  </section>
</main>
