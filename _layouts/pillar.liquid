---
layout: default
---
{% assign pillar_projects = site.projects | where: 'pillar', page.pillar | sort: 'importance' %}
<main class="pillar-page pillar-page--{{ page.pillar }}">
  <section class="pillar-projects" aria-label="{{ page.title }} projects">
    {% if page.project_groups %}
      {% for group_key in page.project_groups %}
        {% assign group = site.data.project_groups[group_key] %}
        {% assign group_projects = pillar_projects | where: 'group', group_key %}
        {% if group %}
          {% include project-group.liquid group=group projects=group_projects group_key=group_key %}
        {% endif %}
      {% endfor %}

      {% assign ungrouped_count = 0 %}
      {% for project in pillar_projects %}
        {% unless project.group %}{% assign ungrouped_count = ungrouped_count | plus: 1 %}{% endunless %}
      {% endfor %}
      {% if ungrouped_count > 0 %}
        <div class="project-index project-index--standalone">
          {% for project in pillar_projects %}
            {% unless project.group %}{% include project-card.liquid project=project %}{% endunless %}
          {% endfor %}
        </div>
      {% endif %}
    {% elsif pillar_projects.size > 0 %}
      <div class="project-index">
        {% for project in pillar_projects %}
          {% include project-card.liquid project=project %}
        {% endfor %}
      </div>
    {% else %}
      <p class="framework-message">Projects in this section remain unpublished until their case-study content is ready.</p>
    {% endif %}
  </section>

  <aside class="observe-bridge">
    <span>OBSERVE / BEFORE THE WORK</span>
    <p>{{ page.observe_text }}</p>
    <a href="{{ '/field-notes/' | relative_url }}">Open field notes ↗</a>
  </aside>
</main>
